# Database
# For local development with SQLite:
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./prisma/dev.db"

# For production/CI with PostgreSQL:
# DATABASE_PROVIDER="postgresql"
# DATABASE_URL="postgresql://username:password@localhost:5432/inventory_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Seed Users (required for npx prisma db seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_NAME=Admin
SEED_MANAGER_EMAIL=manager@example.com
SEED_MANAGER_PASSWORD=change-me
SEED_MANAGER_NAME=Manager

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
AI_MODE=offline

# OCR Engine: auto | google | paddle | simple
OCR_ENGINE=auto
PADDLE_OCR_PYTHON_CMD=python3
PADDLE_OCR_LANG=en

# Google Document AI
GOOGLE_APPLICATION_CREDENTIALS=./path/to/service-account-key.json
GOOGLE_PROJECT_ID=your-project-id
GOOGLE_LOCATION=us
GOOGLE_PROCESSOR_ID=your-processor-id

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Invoice fallback values (used if OCR cannot extract core fields)
INVOICE_FALLBACK_PREFIX=AUTO
INVOICE_FALLBACK_SUPPLIER_NAME=Supplier

# GST Details (Your company)
COMPANY_GSTIN=29ABCDE1234F1Z5
COMPANY_STATE_CODE=29
COMPANY_NAME=Your Company Name
COMPANY_ADDRESS=Your Company Address
